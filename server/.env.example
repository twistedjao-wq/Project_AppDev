# Copy this file to .env and fill in the values. Never commit .env.
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/findmate
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Email for sign-in links. If SMTP_HOST is empty, links are printed in the terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FindMate <no-reply@example.com>"

# Used by "npm run seed:admin" to create the first admin
SUPER_ADMIN_EMAIL=yourname@cvsu.edu.ph
